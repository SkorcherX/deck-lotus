{
  "name": "deck-lotus",
  "version": "1.0.0",
  "description": "Self-hosted MTG deck builder with multi-user support",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "dev": "nodemon src/server.js",
    "import-cards": "node scripts/import-mtgjson.js",
    "init-db": "node scripts/init-db.js",
    "client:dev": "cd client && npm run dev",
    "client:build": "cd client && npm run build",
    "check:themes": "node scripts/check-theme-contrast.mjs",
    "theme:prompt": "node scripts/theme-forge.mjs prompt",
    "theme:slots": "node scripts/theme-forge.mjs slots",
    "check:tokens": "node scripts/check-tokens.mjs",
    "theme:forge": "node scripts/open-forge.mjs",
    "test:integration": "node --test test/integration/*.test.js",
    "test:env": "node scripts/test-env.mjs start",
    "test:env:reset": "node scripts/test-env.mjs reset",
    "test:env:fresh": "node scripts/test-env.mjs fresh"
  },
  "keywords": [
    "mtg",
    "magic the gathering",
    "deck builder"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "better-sqlite3": "^12.11.1",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "crypto": "^1.0.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "dotenv": "^16.3.1",
    "node-cron": "^3.0.3",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
